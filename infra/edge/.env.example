# Copy to .env (cp .env.example .env) and fill in. Never commit .env.

# Email given to Let's Encrypt (expiry warnings, account recovery). Required.
ACME_EMAIL=admin@example.com

# Optional: ACME directory. Leave empty for Let's Encrypt production. To test without hitting the
# production rate limits (README.md), use the staging directory (untrusted test certificates):
#   ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA_SERVER=
