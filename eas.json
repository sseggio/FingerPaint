{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_IAP_PROVIDER": "mock",
        "EXPO_PUBLIC_CATALOG_URL": ""
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_IAP_PROVIDER": "storekit",
        "EXPO_PUBLIC_CATALOG_URL": ""
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_IAP_PROVIDER": "storekit",
        "EXPO_PUBLIC_CATALOG_URL": ""
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6835033152",
        "appleTeamId": "YKWBVHJRCJ"
      }
    }
  }
}
