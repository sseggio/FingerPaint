# Automatic HTTPS (Let's Encrypt) for $DOMAIN. No `log` directive: Caddy writes no access log,
# so no IP address is ever stored.
{
	admin off
}

{$DOMAIN} {
	# The app already gzips /catalog/* itself with its own ETag (and answers If-None-Match
	# with 304). Re-encoding there would rewrite the ETag and break conditional requests, so
	# Caddy only compresses the other routes (admin UI and API).
	@compressible not path /catalog/*
	encode @compressible zstd gzip
	# The app sends HSTS, nosniff and the /admin headers itself (same behaviour behind Nginx);
	# Caddy sets (replaces, never duplicates) the first two as well.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
	reverse_proxy app:8080
}
