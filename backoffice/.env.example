# Copy to .env (cp .env.example .env) and fill in. Never commit .env.

# Sub-domain pointing to the VPS (DNS A record), e.g. catalogue.example.com
DOMAIN=catalogue.example.com

# Output of `npm run hash-password` (or the docker command in README.md). Paste as-is.
ADMIN_PASSWORD_HASH=

# Random secret, at least 32 characters: `openssl rand -hex 32`
SESSION_SECRET=
